# ===================================================================
# KONFIGURASI BOT ASISTEN PRIBADI & PENGINGAT TUGAS
# ===================================================================

# 1. Telegram Bot Token (Dapatkan dari @BotFather di Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 2. Google Gemini API Key (Dapatkan gratis di https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 3. Database URL
# Mode SQLite (Lokal):
DATABASE_URL=sqlite+aiosqlite:///./tasks.db
# Mode PostgreSQL (Produksi / Docker Compose):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/bot_db

# 4. Zona Waktu & Waktu Pengingat
TIMEZONE=Asia/Jakarta
DEFAULT_MORNING_DIGEST_TIME=07:00

# 5. Frekuensi Sinkronisasi Otomatis LMS Vinesa (dalam jam)
LMS_SYNC_INTERVAL_HOURS=3

# 6. Pengaturan Server & Webhook (Opsional untuk deployment)
HOST=0.0.0.0
PORT=8000
WEBHOOK_MODE=false
# WEBHOOK_URL=https://your-domain.com
